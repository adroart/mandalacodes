---
import Base from '../../layouts/Base.astro'
import Library from '../../components/Library.astro'
import { getPublishedArticles, toView, TABS } from '../../lib/articles'

export async function getStaticPaths() {
  // One page per real field (skip the "All" tab, which is the index).
  return TABS.filter(t => t.slug).map(t => ({
    params: { field: t.slug },
    props: { fieldValue: t.value, label: t.label },
  }))
}

interface Props {
  fieldValue: string
  label: string
}

const { fieldValue, label } = Astro.props
const articles = await getPublishedArticles()
const views = articles.map((a, i) => toView(a, i))
const categoryViews = views.filter(view => view.field === fieldValue)
const featured = categoryViews.find(view => view.status === 'article')
const noindex = !featured
const descriptions: Record<string, string> = {
  'Creation Stories': 'The making of mandala art: materials, creative decisions, and the stories behind individual works.',
  Foundations: 'Explore the meaning of mandalas, their forms, and ways of understanding them.',
  Traditions: 'Explore mandalas within the cultural and contemplative traditions that give them meaning.',
  'Symbolism & Geometry': 'Explore the geometry, patterns, and symbolism found in mandala art.',
  History: 'Explore the history of mandala art and related circular forms across cultures.',
}
const description = descriptions[fieldValue] || `Articles on mandalas in the field of ${label}.`

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${label} · Learn · Mandala Codes`,
    description,
    url: new URL(Astro.url.pathname, Astro.site).href,
    isPartOf: { '@type': 'WebSite', name: 'Mandala Codes', url: 'https://mandalacodes.com' },
  },
]
---

<Base
  title={`${label} · Learn · Mandala Codes`}
  description={description}
  jsonLd={jsonLd}
  ogImage={featured?.heroWide}
  ogImageAlt={featured?.coverAlt}
  noindex={noindex}
>
  <Library views={views} active={fieldValue} />
</Base>
