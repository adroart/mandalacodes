---
import Base from '../layouts/Base.astro'
import Library from '../components/Library.astro'
import { getPublishedArticles, toView } from '../lib/articles'
import { absoluteUrl } from '../lib/metadata'

const articles = await getPublishedArticles()
const views = articles.map((a, i) => toView(a, i))

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Learn · Mandala Codes',
    description:
      'Essays and reference articles on mandalas, the I Ching, Gene Keys, and Human Design.',
    url: absoluteUrl('/learn/'),
    isPartOf: { '@type': 'WebSite', name: 'Mandala Codes', url: 'https://mandalacodes.com' },
  },
]
---

<Base
  title="Learn · Mandala Codes"
  description="Essays and reference articles on mandalas, the I Ching, Gene Keys, and Human Design, the living library behind the Universal Language oracle."
  jsonLd={jsonLd}
>
  <Library views={views} active="All" />
</Base>
