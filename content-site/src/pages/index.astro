---
import Base from '../layouts/Base.astro'
import Library from '../components/Library.astro'
import { getPublishedArticles, toView } from '../lib/articles'

const articles = await getPublishedArticles()
const views = articles.map((a, i) => toView(a, i))
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const featured = views[0]
const description = 'Articles on mandala art, the stories behind its creation, and the geometry, history, and traditions that shape it.'

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Learn · Mandala Codes',
    description,
    url: new URL(`${base}/`, Astro.site).href,
    isPartOf: { '@type': 'WebSite', name: 'Mandala Codes', url: 'https://mandalacodes.com' },
  },
]
---

<Base
  title="Learn · Mandala Codes"
  description={description}
  jsonLd={jsonLd}
  ogImage={featured?.heroWide}
  ogImageAlt={featured?.coverAlt}
>
  <Library views={views} active="All" />
</Base>
