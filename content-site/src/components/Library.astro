---
import { TABS, type ArticleView } from '../lib/articles'
import '../styles/library.css'
interface Props { views: ArticleView[]; active?: string }
const { views, active = 'All' } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const isAll = active === 'All'
const available = isAll ? views : views.filter(article => article.field === active)
const featured = isAll ? views[0] : undefined
const rest = available.filter(article => article !== featured)
const spotlight = isAll ? rest.find(article => article.spotlight) || rest[3] : undefined
const listed = rest.filter(article => article !== spotlight)
const ordered = [featured, ...listed.slice(0, 3), spotlight, ...listed.slice(3)].filter((article): article is ArticleView => !!article)
const tabHref = (slug: string) => slug ? `${base}/category/${slug}/` : `${base}/`
---
<div class="library-experience" data-library>
{featured && (
  <section class="lp-hero" data-r="hero" data-library-feature>
    <img class="lp-hero-img" data-r="heroimg" src={featured.heroWide} alt="" fetchpriority="high" width="1600" height="900" />
    <div class="lp-hero-scrim-side"></div>
    <div class="lp-hero-scrim-bottom"></div>
    <div class="lp-hero-frame f1"></div>
    <div class="lp-hero-frame f2"></div>
    <div class="lp-hero-pad">
      <div class="lp-eyebrow">
        <span class="lp-goldline" data-r="goldline"></span>
        <span class="lp-eyebrow-text">Featured Essay · {featured.field}</span>
      </div>
      <h2 class="lp-hero-title">{featured.title}</h2>
      <p class="lp-hero-dek">{featured.description}</p>
      <div class="lp-hero-actions">
        <a class="lp-cta" data-magnetic href={`${base}/${featured.id}/`}>
          Enter the essay <span class="arrow">→</span>
        </a>
        <span class="lp-hero-meta">{featured.date} · {featured.read} read</span>
      </div>
    </div>
    <div class="lp-hero-corner">
      <div class="latest">Latest</div>
      <div class="plate">No. {featured.plate}</div>
    </div>
  </section>
)}

<section class="lp-frame-pad">
  <div class="lp-section-head">
    <div><div class="lp-kicker">Browse</div><h1 class="lp-section-title">{isAll ? 'The Library' : active}</h1></div>
    <nav class="lp-filters" aria-label="Article categories">
      {TABS.map(tab => <a href={tabHref(tab.slug)} class={active === tab.value ? 'is-active' : undefined} aria-current={active === tab.value ? 'page' : undefined}>{tab.label}</a>)}
    </nav>
  </div>
  {available.length > 0 ? <>
  <div class="library-toolbar" data-library-controls hidden>
    <form class="library-search" role="search" data-library-search-form>
      <label for="library-search">Search {isAll ? 'the library' : 'this collection'}</label>
      <div class="library-search-field">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4 4" /></svg>
        <input id="library-search" type="search" placeholder="Find a title, idea, or topic" autocomplete="off" aria-controls="library-articles" data-library-search />
        <button type="button" class="library-search-clear" aria-label="Clear search" data-library-reset hidden><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg></button>
      </div>
    </form>
    <p class="library-result-count" role="status" aria-live="polite" aria-atomic="true" data-library-count>{available.length} {available.length === 1 ? 'article' : 'articles'}</p>
  </div>
  <ul id="library-articles" class="library-editorial" data-library-results>
    {ordered.map(a => <li data-library-card data-featured={a === featured ? 'true' : undefined} hidden={a === featured} data-search={[a.title, a.description, a.field, a.culture, ...a.tags].join(' ')}>
      {a === spotlight ? (
        <a class="lp-spotlight" href={`${base}/${a.id}/`}>
          <div class="lp-spot-figure">
            <img class="lp-spot-img" src={a.coverWide} alt="" width="900" height="675" loading="lazy" decoding="async" />
            <div class="inner"></div>
            <div class="lp-spot-tag">Plate {a.plate} &nbsp;·&nbsp; Universal Language</div>
          </div>
          <div>
            <div class="lp-spot-eyebrow">
              <span class="lp-goldline" data-r="goldline"></span>
              <span class="label">Spotlight · {a.culture}</span>
            </div>
            <h3 class="lp-spot-title">{a.title}</h3>
            <p class="lp-spot-dek">{a.description}</p>
            <span class="lp-spot-cta">Read the essay <span>→</span></span>
          </div>
        </a>
) : (
        <a class="lp-row" data-field={a.field} href={`${base}/${a.id}/`}>
          <div class="lp-row-thumb"><img class="lp-row-img" src={a.cover} alt="" width="460" height="460" loading="lazy" decoding="async" /></div>
          <div>
            <div class="lp-row-field" style={`color:${a.tint}`}>{a.field} · {a.culture}</div>
            <h3 class="lp-row-title">{a.title}</h3>
            <p class="lp-row-dek">{a.description}</p>
            <div class="lp-row-read-m">{a.read} read</div>
          </div>
          <div class="lp-row-no">
            <div class="num" style={`color:${a.tint}`}>{a.roman}</div>
            <div class="read">{a.read}</div>
          </div>
        </a>
)}
    </li>)}
  </ul>
    <div class="library-no-results" data-library-empty hidden>
      <p class="lp-kicker">Keep exploring</p>
      <h3>No articles found</h3>
      <p>Try a different title or topic, or return to the full collection.</p>
      <button type="button" class="library-reset-button" data-library-reset>Clear search <span aria-hidden="true">→</span></button>
    </div>
  </> : <section class="library-empty">
    <p class="lp-kicker">A new collection</p>
    <h2>There are no published articles here yet.</h2>
    <p>This collection will hold accounts of the mandalas and how they are made.</p>
    <a class="library-read-link" href={`${base}/`}>Browse the library <span aria-hidden="true">→</span></a>
  </section>}
</section>
</div>
<script>
  import { initializeLibrary } from '../lib/library-interactions'
  initializeLibrary()
</script>
