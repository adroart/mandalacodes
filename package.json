{
  "name": "mandalacodes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 2222",
    "dev:full": "npm run build && wrangler pages dev dist --port 2222 --ip 127.0.0.1",
    "build:search-index": "tsx scripts/build-search-index.ts",
    "refill:extracts": "node scripts/refill-vault-extracts.mjs",
    "build:oracle-corpus": "tsx scripts/build-oracle-corpus.ts",
    "build:content": "npm --prefix content-site install --no-audit --no-fund && npm --prefix content-site run build && rm -rf public/learn && cp -R content-site/dist public/learn",
    "lint:prose": "tsx scripts/lint-oracle-prose.ts",
    "build:sitemap": "tsx scripts/build-sitemap.ts",
    "prebuild": "tsx scripts/build-search-index.ts && tsx scripts/build-oracle-corpus.ts && npm run lint:prose && npm run build:content && npm run build:sitemap",
    "write": "npm --prefix content-site install --no-audit --no-fund && npm --prefix content-site run dev",
    "build": "vite build && tsx scripts/prerender-cards.ts",
    "build:designer": "cd ../led/lightweaver && npx vite build --base=/design/ && rm -rf ../../mandalacodes/public/design && mkdir -p ../../mandalacodes/public/design && cp -R dist/. ../../mandalacodes/public/design/ && rm -f ../../mandalacodes/public/design/_headers ../../mandalacodes/public/design/_redirects",
    "build:all": "npm run build:designer && npm run build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "generate:qr": "tsx scripts/generate-ul-qr.ts",
    "verify:profile": "tsx scripts/verify-profile-math.ts",
    "generate:land-dots": "tsx scripts/generate-land-dots.ts",
    "test": "npx playwright test",
    "test:mobile": "npx playwright test --project='Mobile Chrome' --reporter=list",
    "test:live-oracle": "LIVE_ORACLE_BASE_URL=https://mandalacodes.com playwright test tests/live-oracle-cards.spec.ts",
    "test:unit": "vitest run",
    "check:migrate-oracle-card": "tsx scripts/migrate-oracle-card.ts --check",
    "backup:atlas": "tsx scripts/backup-atlas.ts",
    "postbuild": "node scripts/build-csp-headers.mjs",
    "lint:tells": "node scripts/oracle-tells.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/karla": "^5.2.8",
    "@fontsource/lora": "^5.2.8",
    "@react-three/fiber": "^8.18.0",
    "astronomy-engine": "^2.1.19",
    "better-auth": "^1.6.18",
    "cobe": "^2.0.1",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-globe.gl": "^2.27.0",
    "react-router-dom": "^7.13.0",
    "three": "^0.166.1",
    "workers-og": "^0.0.27",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260528.1",
    "@fontsource/cinzel": "^5.2.8",
    "@playwright/test": "^1.59.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^25.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/three": "^0.166.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.2.1",
    "d3-geo": "^3.1.1",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.6",
    "qrcode": "^1.5.4",
    "satori": "^0.28.0",
    "tailwindcss": "^4.2.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.6",
    "world-atlas": "^2.0.2"
  }
}
